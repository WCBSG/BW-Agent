/* app.rc —— 可执行文件的图标与版本信息(双击这个 exe 时资源管理器里显示的东西)。
   只用 windres 编译这一份资源,再与源码一起链接。 */
#include <windows.h>

1 ICON "ui/logo.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    1,0,0,0
  PRODUCTVERSION 1,0,0,0
  FILEFLAGSMASK  0x3fL
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "网站安全巡检智能体"
      VALUE "FileDescription",  "网站安全巡检智能体(双击即启动)"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "SecInspectAgent"
      VALUE "OriginalFilename", "网站安全巡检智能体.exe"
      VALUE "ProductName",      "网站安全巡检智能体"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
