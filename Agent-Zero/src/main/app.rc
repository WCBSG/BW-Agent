/* app.rc —— 可执行文件的图标与版本信息(双击这个 exe 时资源管理器里显示的东西)。
   只用 windres 编译这一份资源,再与源码一起链接。
   路径相对 --include-dir(build.bat 传的是 agent\ 与 agent\src)。 */
#include <windows.h>

1 ICON "ui/logo.ico"
/* DPI 感知与系统兼容性声明。没有这一条,高分屏上整个窗口会被 Windows 位图拉伸,
   界面里的字就是糊的。路径相对 windres 的 -I(build.bat 传的是 agent\ 与 agent\src)。 */
1 24 "src/main/app.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    1,0,0,0
  PRODUCTVERSION 1,0,0,0
  FILEFLAGSMASK  0x3fL
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "BlueWhiteAgent"
      VALUE "FileDescription",  "BlueWhiteAgent"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "BlueWhiteAgent"
      VALUE "OriginalFilename", "BlueWhiteAgent.exe"
      VALUE "ProductName",      "BlueWhiteAgent"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
