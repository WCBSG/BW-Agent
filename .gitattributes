# 统一换行与二进制判定 —— 多人协作时最容易吵起来的就是"整文件都变了"
#
# 做法:仓库里一律存 LF,检出时由 Windows 客户端转成 CRLF(核心规则第一行),
# 这样谁在什么系统上都能编译,而 git 里不会有"只有换行不同"的假 diff。
* text=auto eol=lf

# Windows 相关脚本必须保留 CRLF,否则 cmd/PowerShell 的批处理会出问题
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.rc    text eol=crlf

# 源码与文档
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# 二进制:不要做任何换行转换,也不要试图 diff
*.exe    binary
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.docx   binary
*.pdf    binary
*.o      binary
*.obj    binary
