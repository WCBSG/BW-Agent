{
  "version": "1",
  "note": "站点知识全在这里:误发布落点、内容特征、期望的安全响应头、敏感信息正则、弱口令表、验证载荷、目录索引标记、等级与告警策略。改这个文件就能适配新单位,不用改代码、不用重编译;缺哪一项就自动用出厂值(同一个文件的内置副本)。",

  "severity_levels": [
    {"name": "严重", "rank": 4},
    {"name": "高",   "rank": 3},
    {"name": "中",   "rank": 2},
    {"name": "低",   "rank": 1},
    {"name": "信息", "rank": 0}
  ],

  "alerts": {
    "min_rank": 2,
    "immediate_rank": 3,
    "channel_immediate": "邮件",
    "channel_normal": "站内",
    "note": "达到 immediate_rank 的发现走 channel_immediate,其余走 channel_normal;低于 min_rank 的不进告警(只进报告)"
  },

  "patterns": {
    "note": "敏感信息识别用的正则(极简方言:字符类/量词/锚点/非捕获组/前后否定;(?i) 表示忽略大小写)。按本单位口径增删即可。",
    "sensitive": [
      {"kind": "身份证", "pattern": "(?<![0-9])[0-9]{17}[0-9Xx]", "severity": "严重"},
      {"kind": "私钥",   "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "severity": "严重"},
      {"kind": "凭据",   "pattern": "(?i)[A-Za-z0-9_]*(password|passwd|pwd|secret|token|api[_-]?key)[ \t]*[:=][ \t]*[^ \t\r\n]+", "severity": "高"},
      {"kind": "手机号", "pattern": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])", "severity": "高"},
      {"kind": "邮箱",   "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "severity": "中"},
      {"kind": "IP地址", "pattern": "(?<![0-9])([0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9])", "severity": "中"}
    ]
  },

  "markers": {
    "note": "页面结构判定用的标记串:目录索引页长什么样、口令字段叫什么。",
    "dir_listing": ["index of /", "<title>index of", "directory listing for",
                    "[to parent directory]", "parent directory</a>", ">index of /"],
    "login_password_field": "password"
  },

  "payloads": {
    "note": "布尔差分验证用的载荷族(恒真/恒假成对)。不同数据库与框架的引号、括号、注释规则不同,按需增族。",
    "boolean_diff": [
      {"context": "数字",   "true": "1 AND 1=1",     "false": "1 AND 1=2"},
      {"context": "单引号", "true": "1' AND '1'='1", "false": "1' AND '1'='2"},
      {"context": "双引号", "true": "1\" AND \"1\"=\"1", "false": "1\" AND \"1\"=\"2"},
      {"context": "括号",   "true": "1) AND (1=1",   "false": "1) AND (1=2"}
    ]
  },

  "weak_passwords": [
    "123456", "12345678", "123456789", "111111", "888888", "666666", "password",
    "qwerty", "abc123", "admin", "admin123", "root", "letmein", "iloveyou",
    "welcome", "123qwe", "a123456", "p@ssw0rd", "test123", "123123", "5201314",
    "woaini", "dbapp", "hengnao", "88888888", "000000", "1234567890"
  ],

  "probing": {
    "max_paths": 40,
    "max_dirs": 40,
    "max_params": 3,
    "timeout_ms": 20000,
    "similar_bytes": 64,
    "similar_ratio": 0.06
  },
  "sensitive_paths": [
    "/.env", "/.env.bak", "/.env.save", "/config/.env", "/portal/.env",
    "/.git/config", "/.git/HEAD", "/.svn/entries", "/.hg/hgrc", "/.DS_Store",
    "/backup.sql", "/db.sql", "/dump.sql", "/database.sql", "/www.sql",
    "/backup.zip", "/www.zip", "/web.zip", "/site.tar.gz",
    "/index.php.bak", "/config.php.bak", "/web.config.bak", "/config.yml.bak",
    "/application.yml", "/application.properties", "/config.json", "/.npmrc",
    "/phpinfo.php", "/info.php", "/WEB-INF/web.xml", "/META-INF/MANIFEST.MF",
    "/id_rsa", "/.ssh/id_rsa", "/private.key", "/error.log", "/debug.log"
  ],
  "dir_candidates": [
    "/uploads/", "/upload/", "/files/", "/download/", "/downloads/",
    "/backup/", "/bak/", "/db/", "/database/", "/data/", "/log/", "/logs/",
    "/temp/", "/tmp/", "/cache/", "/static/", "/assets/", "/public/",
    "/admin/", "/manage/", "/manager/", "/system/", "/console/", "/druid/",
    "/phpmyadmin/", "/adminer.php", "/wp-admin/", "/actuator/", "/swagger-ui.html"
  ],
  "signatures": [
    {"name": "配置文件泄露", "kind": "敏感信息", "severity": "严重",
     "tag": "config-secrets",
     "body_any": ["DB_PASSWORD=", "DB_HOST=", "DB_USER=", "REDIS_PASSWORD=",
                  "SECRET_KEY=", "APP_KEY=", "AWS_SECRET_ACCESS_KEY"],
     "body_not_any": ["<html", "<!doctype"], "min_bytes": 20},
    {"name": "数据库备份文件", "kind": "敏感信息", "severity": "严重",
     "tag": "sql-dump",
     "body_any": ["INSERT INTO", "CREATE TABLE", "DROP TABLE", "MySQL dump",
                  "PostgreSQL database dump"],
     "body_not_any": ["<html", "<!doctype"], "min_bytes": 64},
    {"name": "私钥文件", "kind": "敏感信息", "severity": "严重",
     "tag": "private-key",
     "body_any": ["BEGIN RSA PRIVATE KEY", "BEGIN PRIVATE KEY",
                  "BEGIN OPENSSH PRIVATE KEY", "BEGIN EC PRIVATE KEY"]},
    {"name": "版本库元数据", "kind": "敏感信息", "severity": "高",
     "tag": "vcs-metadata",
     "body_any": ["[core]", "repositoryformatversion", "ref: refs/",
                  "svn:wc:", "<wc-entries"]},
    {"name": "数据库连接配置", "kind": "敏感信息", "severity": "高",
     "tag": "db-uri",
     "body_any": ["jdbc:mysql", "jdbc:postgresql", "mongodb://", "redis://",
                  "mysql://", "postgres://"],
     "body_not_any": ["<html", "<!doctype"], "min_bytes": 16},
    {"name": "源码备份", "kind": "敏感信息", "severity": "高", "tag": "source-backup",
     "path_suffix_any": [".bak", ".old", ".orig", ".save", ".swp", ".tmp", "~"],
     "body_any": ["<?php", "#include", "package ", "<configuration", "function "],
     "min_bytes": 64},
    {"name": "归档文件", "kind": "敏感信息", "severity": "中", "tag": "archive",
     "body_prefix_any": ["PK"], "min_bytes": 512},
    {"name": "环境信息页", "kind": "敏感信息", "severity": "中", "tag": "phpinfo",
     "body_any": ["PHP Version =>", "<title>phpinfo()</title>"]},
    {"name": "日志文件", "kind": "敏感信息", "severity": "中", "tag": "log-file",
     "path_suffix_any": [".log"],
     "body_any": ["ERROR", "WARN", "Exception", "INFO "], "min_bytes": 512},
    {"name": "Java 应用配置清单", "kind": "敏感信息", "severity": "中",
     "tag": "java-web-config", "path_suffix_any": ["web.xml", "MANIFEST.MF"],
     "body_any": ["<web-app", "Manifest-Version"]}
  ],
  "weak_headers": [
    {"name": "strict-transport-security", "title": "未启用 HSTS", "severity": "中",
     "only_https": 1,
     "impact": "首次访问或证书异常时容易被降级劫持",
     "fix": "在 HTTPS 站点启用 HSTS 并设置合理的 max-age"},
    {"name": "content-security-policy", "title": "缺少内容安全策略(CSP)", "severity": "中",
     "impact": "对脚本注入缺少第二道拦截",
     "fix": "按业务梳理资源白名单后逐步启用 CSP"},
    {"name": "x-content-type-options", "title": "缺少 MIME 嗅探防护", "severity": "低",
     "impact": "浏览器可能把非脚本内容当脚本执行",
     "fix": "增加 X-Content-Type-Options: nosniff"},
    {"name": "x-frame-options", "title": "缺少点击劫持防护", "severity": "低",
     "impact": "页面可被第三方框架嵌入用于诱导点击",
     "fix": "增加 X-Frame-Options: SAMEORIGIN 或 CSP 的 frame-ancestors"},
    {"name": "referrer-policy", "title": "缺少引用来源策略", "severity": "信息",
     "impact": "外跳时可能把内部地址带出去",
     "fix": "增加 Referrer-Policy: strict-origin-when-cross-origin"},
    {"name": "permissions-policy", "title": "缺少浏览器特性策略", "severity": "信息",
     "impact": "摄像头、定位等浏览器特性未被约束",
     "fix": "按需增加 Permissions-Policy"}
  ],
  "profile_keywords": ["身份证", "内部文件", "测试账号", "数据库口令"],
  "profile_file_types": [".env", ".sql", ".bak", ".zip", ".log", ".config", ".yml"],
  "server_header_keys": ["server", "x-powered-by", "x-aspnet-version",
                          "x-aspnetmvc-version", "x-generator", "x-runtime", "via"],
  "error_signatures": ["sql syntax", "you have an error in your sql",
                        "warning: mysql", "mysqli_", "pg_query", "postgresql query failed",
                        "ora-0", "oracle error", "sqlite3_", "unclosed quotation mark",
                        "odbc sql server driver", "system.data.sqlclient", "jdbc.exception",
                        "traceback (most recent call last)", "fatal error:", "notice: undefined",
                        "warning: include", "microsoft ole db provider"],
  "dangerous_methods": ["PUT", "DELETE", "TRACE", "PATCH", "CONNECT", "COPY", "MOVE"],
  "suspicious_tlds": [".xyz", ".top", ".cc", ".biz", ".click", ".work", ".win",
                       ".bid", ".loan", ".review", ".gq", ".cf", ".tk", ".ml", ".su"],
  "tamper": {"report_external_hosts": 8}
}
