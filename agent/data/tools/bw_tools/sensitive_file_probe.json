{
  "name": "sensitive_file_probe",
  "kind": "内置",
  "readonly": true,
  "impl": "sensitive_file_probe",
  "description": "探测误发布的配置、备份、源码与元数据文件:按当前生效的落点清单逐个只读取回,再按内容特征判定(不靠文件名猜),对自定义错误页不会误报。",
  "schema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "额外要试的路径(不传则用规则里的清单)"
      }
    },
    "required": [
      "target"
    ],
    "additionalProperties": false
  },
  "source": "~/tools/bw_tools/bw_tools.exe"
}
