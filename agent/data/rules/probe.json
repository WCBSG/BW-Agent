{
  "probing": {
    "max_paths": 40,
    "max_dirs": 40,
    "max_params": 3,
    "timeout_ms": 20000,
    "similar_bytes": 64,
    "similar_ratio": 0.06
  },
  "sensitive_paths": [
    "/.env",
    "/.env.bak",
    "/.env.save",
    "/config/.env",
    "/portal/.env",
    "/.git/config",
    "/.git/HEAD",
    "/.svn/entries",
    "/.hg/hgrc",
    "/.DS_Store",
    "/backup.sql",
    "/db.sql",
    "/dump.sql",
    "/database.sql",
    "/www.sql",
    "/backup.zip",
    "/www.zip",
    "/web.zip",
    "/site.tar.gz",
    "/index.php.bak",
    "/config.php.bak",
    "/web.config.bak",
    "/config.yml.bak",
    "/application.yml",
    "/application.properties",
    "/config.json",
    "/.npmrc",
    "/phpinfo.php",
    "/info.php",
    "/WEB-INF/web.xml",
    "/META-INF/MANIFEST.MF",
    "/id_rsa",
    "/.ssh/id_rsa",
    "/private.key",
    "/error.log",
    "/debug.log"
  ],
  "dir_candidates": [
    "/uploads/",
    "/upload/",
    "/files/",
    "/download/",
    "/downloads/",
    "/backup/",
    "/bak/",
    "/db/",
    "/database/",
    "/data/",
    "/log/",
    "/logs/",
    "/temp/",
    "/tmp/",
    "/cache/",
    "/static/",
    "/assets/",
    "/public/",
    "/admin/",
    "/manage/",
    "/manager/",
    "/system/",
    "/console/",
    "/druid/",
    "/phpmyadmin/",
    "/adminer.php",
    "/wp-admin/",
    "/actuator/",
    "/swagger-ui.html"
  ]
}