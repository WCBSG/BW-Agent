{
  "patterns": {
    "note": "敏感信息识别用的正则(极简方言:字符类/量词/锚点/非捕获组/前后否定;(?i) 表示忽略大小写)。按本单位口径增删即可。",
    "sensitive": [
      {
        "kind": "身份证",
        "pattern": "(?<![0-9])[0-9]{17}[0-9Xx]",
        "severity": "严重"
      },
      {
        "kind": "私钥",
        "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "severity": "严重"
      },
      {
        "kind": "凭据",
        "pattern": "(?i)[A-Za-z0-9_]*(password|passwd|pwd|secret|token|api[_-]?key)[ \t]*[:=][ \t]*[^ \t\r\n]+",
        "severity": "高"
      },
      {
        "kind": "手机号",
        "pattern": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
        "severity": "高"
      },
      {
        "kind": "邮箱",
        "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
        "severity": "中"
      },
      {
        "kind": "IP地址",
        "pattern": "(?<![0-9])([0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9])",
        "severity": "中"
      }
    ]
  }
}